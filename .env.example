# Токен бота от @BotFather. Пусто: работают только панель и REST API.
TELEGRAM_BOT_TOKEN=

# Ключ LLM-провайдера (OpenAI-совместимый API с вызовом функций). Для локальной Ollama не нужен.
LLM_API_KEY=

# По умолчанию GLM (Z.ai) с моделью glm-5.3-flash. Чтобы сменить, раскомментируйте:
# LLM_BASE_URL=https://api.z.ai/api/paas/v4            # обычный ключ Z.ai
# LLM_BASE_URL=https://api.z.ai/api/coding/paas/v4     # ключ тарифа GLM Coding Plan
# LLM_BASE_URL=https://api.openai.com/v1               # OpenAI (LLM_MODEL=gpt-4.1-mini)
# LLM_BASE_URL=http://host.docker.internal:11434/v1    # локальная Ollama
# LLM_MODEL=glm-5.3-flash

# Необязательно:
# TZ=Europe/Moscow            # часовой пояс для «сегодня» и «вчера»
# ALLOWED_USER_IDS=1,2        # Telegram ID, кому можно пользоваться ботом (пусто: всем)
# WEB_PORT=8080               # порт панели на хосте
