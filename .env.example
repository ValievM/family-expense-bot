# PostgreSQL connection string. In docker compose it is set automatically.
DATABASE_URL=

# Address of the REST API and bot process.
HTTP_ADDR=:8080

# Time zone used for "today", "yesterday" and stored calendar dates.
TZ=Europe/Moscow

# Telegram bot token from @BotFather. Leave empty to run only the REST API and web panel.
TELEGRAM_BOT_TOKEN=
# Optional comma-separated Telegram IDs allowed to use the bot. Empty means everyone.
ALLOWED_USER_IDS=

# LLM access. Two modes:
#  apikey (default): any OpenAI-compatible chat completions API with tool calling.
#    OpenAI: keep the defaults and set LLM_API_KEY. Ollama: LLM_BASE_URL=http://host.docker.internal:11434/v1 and any LLM_MODEL.
#  oauth: use your ChatGPT plan through "Sign in with ChatGPT". Run `make chatgpt-login` once, then set LLM_AUTH=oauth.
#    LLM_MODEL may stay empty: the first model available to your account is used.
LLM_AUTH=apikey
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
# Where `make chatgpt-login` stores the tokens (the compose file mounts ./data into the container).
LLM_AUTH_FILE=data/chatgpt-auth.json
# Needed only in oauth mode on Linux: lets the container refresh tokens in ./data. Set to `id -u` and `id -g`.
LOCAL_UID=
LOCAL_GID=
