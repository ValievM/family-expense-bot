@startuml class-diagram
' Диаграмма классов выполнена в нотации UML (ГОСТ Р ИСО/МЭК 19501-2010, UML 1.4.2):
' класс из трёх секций (имя, атрибуты, операции), видимость + (public) и - (private),
' стереотип «interface» для интерфейсов, пакеты для слоёв, кратность на концах ассоциаций.
' Генерация: PLANTUML_LIMIT_SIZE=20000 plantuml -tsvg class-diagram.puml

title Диаграмма классов: Семейный учёт расходов (Go, hexagonal)\n(файл векторный: открывайте class-diagram.svg и масштабируйте)

skinparam guillemet true
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam packageStyle rectangle
skinparam linetype polyline
skinparam nodesep 30
skinparam ranksep 50
skinparam dpi 110
left to right direction
hide circle
hide empty members

package "domain (предметная область, DDD)" {
  class Expense <<entity, aggregate root>> {
    -id : ExpenseID
    -owner : UserID
    -amount : Money
    -category : Category
    -spentOn : Day
    -comment : Comment
    -createdAt : time.Time
    -updatedAt : time.Time
    +NewExpense(NewExpenseInput) : Expense, error
    +Restore(Snapshot) : Expense, error
    +Apply(Changes, now) : Expense, error
    +WithID(ExpenseID) : Expense
    +OwnedBy(UserID) : bool
    +ID() : ExpenseID
    +Owner() : UserID
    +Amount() : Money
    +Category() : Category
    +SpentOn() : Day
    +Comment() : Comment
    -validate() : error
  }
  class Money <<value object>> {
    -kopecks : int64
    +NewMoney(kopecks) : Money, error
    +ParseRubles(string) : Money, error
    +Kopecks() : int64
    +IsPositive() : bool
    +Add(Money) : Money
    +String() : string
  }
  class Day <<value object>> {
    -date : time.Time
    +NewDay(y, m, d) : Day, error
    +ParseDay(string) : Day, error
    +DayOf(time.Time, *Location) : Day
    +Compare(Day) : int
    +String() : string
  }
  class UserID <<value object>> {
    -value : int64
    +NewUserID(int64) : UserID, error
    +Int64() : int64
  }
  class Comment <<value object>> {
    -text : string
    +NewComment(string) : Comment, error
    +String() : string
  }
  class Category <<value object>> {
    +ParseCategory(string) : Category, error
    +Label() : string
    +IsValid() : bool
    +Categories() : []Category
  }
  class Member <<entity>> {
    -id : UserID
    -name : string
    -username : string
    +NewMember(UserID, name, username) : Member, error
    +ID() : UserID
    +Name() : string
    +Username() : string
  }
  class Changes <<value object>> {
    +Amount : *Money
    +Category : *Category
    +SpentOn : *Day
    +Comment : *Comment
  }
}

package "service/expense (сценарии трат)" {
  class Service {
    -repository : Repository
    -clock : Clock
    -location : *time.Location
    +NewService(Repository, Clock, *Location) : *Service
    +ForUser(owner UserID) : UserExpenses
    +Create(ctx, Expense) : Expense, error
    +Get(ctx, id) : Expense, error
    +List(ctx, ListFilter) : []Expense, error
    +ListUserIDs(ctx) : []int64, error
    +Update(ctx, ExpenseID, Changes) : Expense, error
    +Delete(ctx, id) : error
  }
  class UserExpenses <<scope>> {
    -service : *Service
    -owner : UserID
    +Create(ctx, UserCreateInput) : Expense, error
    +Get(ctx, id) : Expense, error
    +List(ctx, ListFilter) : []Expense, error
    +Update(ctx, ExpenseID, Changes) : Expense, error
    +Delete(ctx, id) : error
  }
  class ListFilter <<value object>> {
    +Owner : *UserID
    +Category : *Category
    +From : *Day
    +To : *Day
  }
  class CreateInput <<value object>> {
    +Owner : UserID
    +Amount : Money
    +Category : Category
    +SpentOn : *Day
    +Comment : Comment
  }
}

package "service/agent (ИИ-агент)" {
  class Agent {
    -llm : LLM
    -scope : ScopeFactory
    -tools : *ToolSet
    -history : History
    -clock : Clock
    -location : *time.Location
    -maxSteps : int
    +New(LLM, ScopeFactory, *ToolSet, Clock, ...Option) : *Agent
    +Handle(ctx, userID, text) : string, error
    -runTool(ctx, userID, expenses, ToolCall) : string, error
  }
  class ToolSet {
    -ordered : []Tool
    -byName : map[string]Tool
    +Specs() : []ToolSpec
    +Get(name) : Tool, bool
  }
  class memoryHistory {
    -limit : int
    -byUser : map[int64][]Message
    +Recent(userID) : []Message
    +Remember(userID, ...Message)
  }
  class Message <<value object>> {
    +Role : Role
    +Content : string
    +ToolCalls : []ToolCall
    +ToolCallID : string
  }
  class ToolCall <<value object>> {
    +ID : string
    +Name : string
    +Arguments : json.RawMessage
  }
  class ToolSpec <<value object>> {
    +Name : string
    +Description : string
    +Parameters : json.RawMessage
  }
  class Request <<value object>> {
    +Messages : []Message
    +Tools : []ToolSpec
  }
  class ArgumentError {
    +Message : string
    +Error() : string
  }
}

package "service/agent/tools (инструменты агента)" {
  class addExpenseTool {
    -location : *time.Location
    +Spec() : ToolSpec
    +Execute(ctx, PortUserExpenses, json) : any, error
  }
  class listExpensesTool {
    -location : *time.Location
    +Spec() : ToolSpec
    +Execute(ctx, PortUserExpenses, json) : any, error
  }
  class updateExpenseTool {
    -location : *time.Location
    +Spec() : ToolSpec
    +Execute(ctx, PortUserExpenses, json) : any, error
  }
  class deleteExpenseTool {
    -location : *time.Location
    +Spec() : ToolSpec
    +Execute(ctx, PortUserExpenses, json) : any, error
  }
}

package "ports (порты: интерфейсы между слоями)" {
  interface ExpenseRepository <<interface>> {
    +Create(ctx, Expense) : Expense, error
    +Get(ctx, ExpenseID) : Expense, error
    +List(ctx, ListFilter) : []Expense, error
    +ListUserIDs(ctx) : []UserID, error
    +Update(ctx, Expense) : Expense, error
    +Delete(ctx, ExpenseID) : error
  }
  interface ExpenseService <<interface>> {
    +Create(ctx, CreateInput) : Expense, error
    +List(ctx, ListFilter) : []Expense, error
    +ListUserIDs(ctx) : []UserID, error
    +Update(ctx, ExpenseID, Changes) : Expense, error
    +Delete(ctx, ExpenseID) : error
  }
  interface "UserExpenses" as PortUserExpenses <<interface>> {
    +Create(ctx, UserCreateInput) : Expense, error
    +Get(ctx, ExpenseID) : Expense, error
    +List(ctx, ListFilter) : []Expense, error
    +Update(ctx, ExpenseID, Changes) : Expense, error
    +Delete(ctx, ExpenseID) : error
  }
  interface LLM <<interface>> {
    +Complete(ctx, Request) : Message, error
  }
  interface Tool <<interface>> {
    +Spec() : ToolSpec
    +Execute(ctx, PortUserExpenses, json) : any, error
  }
  interface History <<interface>> {
    +Recent(userID) : []Message
    +Remember(userID, ...Message)
  }
  interface Clock <<interface>> {
    +Now() : time.Time
  }
  interface MemberRepository <<interface>> {
    +Upsert(ctx, Member) : error
    +List(ctx) : []Member, error
  }
  interface MemberDirectory <<interface>> {
    +Remember(ctx, userID, name, username) : error
  }
  interface MemberCatalog <<interface>> {
    +List(ctx) : []Member, error
  }
  interface Pinger <<interface>> {
    +Ping(ctx) : error
  }
  interface Responder <<interface>> {
    +Handle(ctx, userID, text) : string, error
  }
  interface AccessPolicy <<interface>> {
    +IsUserAllowed(userID) : bool
  }
}

package "service/member (каталог членов семьи)" {
  class MemberService {
    -repository : MemberRepository
    +Remember(ctx, userID, name, username) : error
    +List(ctx) : []Member, error
  }
}

package "adapters/systemclock" {
  class SystemClock {
    +Now() : time.Time
  }
}

package "adapters/postgres" {
  class PostgresRepository {
    -pool : *pgxpool.Pool
    -location : *time.Location
    +Create(ctx, Expense) : Expense, error
    +Get(ctx, ExpenseID) : Expense, error
    +List(ctx, ListFilter) : []Expense, error
    +ListUserIDs(ctx) : []UserID, error
    +Update(ctx, Expense) : Expense, error
    +Delete(ctx, ExpenseID) : error
  }
}

package "adapters/postgres (члены семьи)" {
  class PostgresMemberRepository {
    -pool : *pgxpool.Pool
    +Upsert(ctx, Member) : error
    +List(ctx) : []Member, error
  }
}

package "adapters/httpapi" {
  class HTTPServer {
    -expenses : ExpenseService
    -members : MemberCatalog
    -health : Pinger
    -location : *time.Location
    -logger : *slog.Logger
    +Handler() : http.Handler
  }
}

package "adapters/llm" {
  interface Authorizer <<interface>> {
    +Authorize(ctx, *http.Request) : error
  }
  class APIKeyAuthorizer {
    -key : string
    +Authorize(ctx, *http.Request) : error
  }
  class ChatClient {
    -baseURL : string
    -model : string
    -authorizer : Authorizer
    -httpClient : *http.Client
    +Complete(ctx, Request) : Message, error
  }
  class ResponsesClient {
    -baseURL : string
    -model : string
    -authorizer : Authorizer
    -httpClient : *http.Client
    +Complete(ctx, Request) : Message, error
    -resolveModel(ctx) : string, error
  }
  class APIError {
    +Status : int
    +Message : string
    +Error() : string
  }
}

package "adapters/chatgpt (вход через ChatGPT)" {
  interface TokenStore <<interface>> {
    +Load() : Credentials, error
    +Save(Credentials) : error
  }
  class FileStore {
    -path : string
    +Load() : Credentials, error
    +Save(Credentials) : error
  }
  class Credentials {
    +ClientID : string
    +HostID : string
    +AccessToken : string
    +RefreshToken : string
    +ExpiresAt : time.Time
    +Scope : string
    +HasPlanScope() : bool
    +ExpiresWithin(now, window) : bool
  }
  class OAuth {
    +AuthorizeURL : string
    +TokenURL : string
    +HTTPClient : *http.Client
    +Refresh(ctx, Credentials) : Credentials, error
  }
  class TokenSource {
    -store : TokenStore
    -oauth : *OAuth
    -credentials : Credentials
    +Token(ctx) : string, error
    +Authorize(ctx, *http.Request) : error
  }
}

package "adapters/telegram" {
  interface Gateway <<interface>> {
    +GetUpdates(ctx, offset, timeout) : []Update, error
    +SendMessage(ctx, chatID, text) : error
    +SendTyping(ctx, chatID) : error
    +SendHTML(ctx, chatID, html) : error
    +SetProfile(ctx, Profile) : error
  }
  class Bot {
    -gateway : Gateway
    -responder : Responder
    -access : AccessPolicy
    -directory : MemberDirectory
    -queues : sync.Map
    +NewBot(Gateway, Responder, AccessPolicy, ...BotOption) : *Bot
    +Run(ctx) : error
    -dispatch(ctx, Message)
    -safeHandle(ctx, Message)
    -handle(ctx, Message)
  }
  class TelegramClient {
    -token : string
    -baseURL : string
    -httpClient : *http.Client
    +GetUpdates(ctx, offset, timeout) : []Update, error
    +SendMessage(ctx, chatID, text) : error
    +SendTyping(ctx, chatID) : error
    +SendHTML(ctx, chatID, html) : error
    +SetProfile(ctx, Profile) : error
  }
  class Update <<value object>> {
    +UpdateID : int64
    +Message : *Message
  }
}

package "config" {
  class Config {
    +DatabaseURL : string
    +HTTPAddr : string
    +TelegramToken : string
    +AllowedUserIDs : map[int64]struct{}
    +LLMAuth : string
    +LLMBaseURL : string
    +LLMModel : string
    +Location : *time.Location
    +Load(getenv) : Config, error
    +IsUserAllowed(userID) : bool
  }
}

' ===== Ассоциации внутри домена и сервиса =====
Expense "1" *-- "1" Money : сумма
Expense "1" *-- "1" Day : день траты
Expense "1" *-- "1" UserID : владелец
Expense "1" *-- "1" Comment
Expense "1" --> "1" Category : категория
Expense ..> Changes : «Apply»
Service "1" o-- "1" ExpenseRepository : хранит через
Service "1" --> "1" Clock : время
Service ..> UserExpenses : «create» (ForUser)
UserExpenses "1" --> "1" Service : делегирует
Service ..> ListFilter
Service ..> CreateInput
Service ..> Changes
ListFilter ..> Category

' ===== Реализация интерфейсов (обобщение-реализация) =====
PostgresRepository ..|> ExpenseRepository
SystemClock ..|> Clock
UserExpenses ..|> PortUserExpenses
Service ..|> ExpenseService
memoryHistory ..|> History
addExpenseTool ..|> Tool
listExpensesTool ..|> Tool
updateExpenseTool ..|> Tool
deleteExpenseTool ..|> Tool
ChatClient ..|> LLM
ResponsesClient ..|> LLM
APIKeyAuthorizer ..|> Authorizer
TokenSource ..|> Authorizer
FileStore ..|> TokenStore
TelegramClient ..|> Gateway
Agent ..|> Responder
Config ..|> AccessPolicy

' ===== Агент =====
Agent "1" --> "1" LLM
Agent "1" *-- "1" ToolSet : состоит из
Agent "1" --> "1" History
Agent ..> PortUserExpenses : получает по ScopeFactory
ToolSet "1" o-- "1..*" Tool
Tool ..> PortUserExpenses : работает только\nс владельцем сообщения
addExpenseTool ..> ArgumentError : «throws»
LLM ..> Request
LLM ..> Message
Request "1" *-- "0..*" Message
Request "1" *-- "0..*" ToolSpec
Message "1" *-- "0..*" ToolCall

' ===== Адаптеры =====
HTTPServer "1" --> "1" ExpenseService
ChatClient "1" --> "1" Authorizer
ResponsesClient "1" --> "1" Authorizer
ChatClient ..> APIError : «throws»
ResponsesClient ..> APIError : «throws»
TokenSource "1" --> "1" TokenStore
TokenSource "1" --> "1" OAuth
TokenSource "1" *-- "1" Credentials
TokenStore ..> Credentials
Bot "1" --> "1" Gateway
Bot "1" --> "1" Responder
Bot "1" --> "1" AccessPolicy
Gateway ..> Update

' ===== Члены семьи и проверка базы =====
Member "1" *-- "1" UserID
MemberService ..|> MemberDirectory
MemberService ..|> MemberCatalog
MemberService "1" --> "1" MemberRepository
PostgresMemberRepository ..|> MemberRepository
HTTPServer "1" --> "1" MemberCatalog
HTTPServer "1" --> "1" Pinger
Bot "1" --> "0..1" MemberDirectory

note bottom of UserExpenses
  Изоляция пользователей по конструкции: у типа нет
  параметра «владелец», user_id задаётся кодом из Telegram,
  а не моделью. Агент видит только интерфейс PortUserExpenses.
end note

note right of Config
  Сборка зависимостей выполняется
  в cmd/server (композиционный корень).
end note

legend bottom
  Нотация UML (ГОСТ Р ИСО/МЭК 19501-2010).
  ──▷ (пунктир) реализация интерфейса;  ◆── композиция;  ◇── агрегация;
  ──> ассоциация (направленная);  ┄> зависимость.
  Видимость: + открытая (exported), − закрытая (unexported).
  Имена типов в пакетах: PostgresRepository = postgres.ExpenseRepository,
  ChatClient = llm.Client, HTTPServer = httpapi.Server,
  TelegramClient = telegram.Client, PortUserExpenses = agent.UserExpenses.
endlegend
@enduml
